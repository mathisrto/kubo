# Firebase Configuration
# Obtenez ces valeurs depuis la console Firebase: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=votre_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kubo-mr.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kubo-mr
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kubo-mr.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=votre_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=votre_app_id
NEXT_PUBLIC_MEASUREMENT_ID=votre_measurement_id

# Database Configuration
DATABASE_ROOT_USERNAME=root
DATABASE_ROOT_PASSWORD=password123
DATABASE_BROWSER_USERNAME=browser_user
DATABASE_BROWSER_PASSWORD=browser_password
DATABASE_URI=localhost:27017
